# Ahududu - Ortam Degiskenleri
# cp .env.example .env  ve degerleri doldurun. .env dosyasini commit'lemeyin.

# PostgreSQL baglantisi (asyncpg surucusu)
DATABASE_URL="postgresql+asyncpg://kullanici:sifre@localhost:5432/ahududu"

# JWT imzalama anahtari (zorunlu, rastgele)
JWT_SECRET=""

# Uygulamanin dis adresi
PUBLIC_URL="http://localhost:33470"

# Cloudflare Tunnel kullaniyorsaniz doldurun (bkz. CLOUDFLARE_GUIDE.md)
# CLOUDFLARE_TUNNEL_TOKEN=""
