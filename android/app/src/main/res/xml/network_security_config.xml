<?xml version="1.0" encoding="utf-8"?>
<!-- Yerel ağdaki sunucuya düz HTTP'ye yalnızca bu adreste izin verilir. -->
<!-- 127.0.0.1: yalnızca geliştirme sırasında `adb reverse` tüneliyle test sunucusuna erişim için. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.2.170</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
