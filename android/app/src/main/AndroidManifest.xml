<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Konum paylaşımı: yalnızca kullanıcı açıkça etkinleştirdiğinde kullanılır. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Titreşim: partnerin gönderdiği dokunuşu hissettirmek için. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Sesli not kaydı (izin yalnızca kayıt sırasında istenir). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- APK güncellemesi: paket kurulum ekranını açmak için. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".AhududuApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Ahududu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- İndirilen APK'yı kurulum ekranına vermek için. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Device Owner: sessiz APK güncellemesi (tek seferlik ADB ile etkinleştirilir). -->
        <receiver
            android:name=".AhududuDeviceAdmin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Sessiz kurulum sonucunu dinler. -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <!-- Erişilebilirlik ile otomatik kurulum onaylayıcı -->
        <service
            android:name=".AutoInstallService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_install_service" />
        </service>
    </application>
</manifest>
