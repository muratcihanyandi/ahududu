FROM node:22-alpine

RUN apk add --no-cache wget tini openssl libc6-compat \
  && npm install -g pnpm@10

WORKDIR /app
ENV NODE_ENV=production \
    PORT=2567 \
    AETHERIA_DATA_DIR=/data/aetheria \
    DATABASE_URL=file:/data/aetheria/aetheria.db

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/client/package.json packages/client/

RUN pnpm install --filter @game/shared --filter @game/server --prod --no-frozen-lockfile --ignore-scripts

COPY packages/shared/dist packages/shared/dist
COPY packages/server/dist packages/server/dist
COPY packages/server/prisma packages/server/prisma
COPY packages/client/dist packages/client/dist

RUN cd packages/server && ./node_modules/.bin/prisma generate

RUN printf '#!/bin/sh\nset -e\nmkdir -p /data/aetheria\ncd /app/packages/server\n./node_modules/.bin/prisma db push --skip-generate --accept-data-loss=false || ./node_modules/.bin/prisma db push --skip-generate\nexec node --enable-source-maps /app/packages/server/dist/index.js\n' > /app/docker-entrypoint.sh \
  && chmod +x /app/docker-entrypoint.sh \
  && mkdir -p /data/aetheria \
  && chown -R node:node /app /data/aetheria

USER node

EXPOSE 2567
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:2567/health > /dev/null || exit 1

ENTRYPOINT ["/sbin/tini", "--", "/app/docker-entrypoint.sh"]
