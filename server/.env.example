# Ahududu sunucu ortam değişkenleri — gerçek değerleri .env dosyasına kopyalayın (.env depoya girmez)
# Veritabanı (Pi üzerindeki postgres_db içindeki ahududu veritabanı)
DATABASE_URL=postgresql://ahududu_app:PAROLA_BURAYA@192.168.2.170:5432/ahududu

# HTTP + WebSocket portu
PORT=8787

# Medya dosya dizini (konteyner içinde; Pi'de compose bu yolu /DATA/AppData/ahududu/media'ya bağlar)
MEDIA_DIR=/app/media

# Oturum ve davet süreleri (gün)
TOKEN_TTL_DAYS=180
INVITE_TTL_DAYS=7

NODE_ENV=development
