{
  "name": "ahududu-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/*.test.ts\"",
    "test:integration": "node --test --test-reporter=spec \"test/*.integration.test.ts\"",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts up",
    "db:rollback": "node --env-file-if-exists=.env src/db/migrate.ts down"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
